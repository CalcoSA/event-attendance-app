# Contenido del secret APP_ENV_FILE de GitHub.
# Compose lo lee en formato raw: valores literales, sin comillas alrededor.
# Los caracteres $ y # en DB_PASSWORD se conservan tal cual.
# No copies este archivo dentro de las imágenes.
APP_ENV=production
DB_HOST=IP_PRIVADA_O_DNS_DE_MYSQL
DB_PORT=3306
DB_NAME=bdcalco_event_attendance
DB_USER=change-me
DB_PASSWORD=change-me
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
COOKIE_SECURE=true
TIMEZONE=America/Bogota
EVENT_CODE=FIESTA_NINOS_2026
CORS_ORIGINS=[]
